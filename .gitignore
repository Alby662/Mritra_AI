# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Data — never commit (CLAUDE.md §8)
data/raw/*
!data/raw/CHECKSUMS
data/parquet/
data/*.json

# Secrets — keys, certs, tokens
secrets/
kaggle.json
*.key
*.pem

# Generated models
results/models/

# Per-run feature tables and models (large, reproducible from the manifest) -- the
# manifest.json and eval.json themselves are small and kept.
results/runs/*/features/
results/runs/*/models/
results/runs/.last_run_id

# Demo transparency log (scripts/replay_stream.py, dashboard)
results/demo_tlog.db*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
