FROM python:3.11-slim

WORKDIR /app
COPY . /app

RUN pip install --no-cache-dir fastapi uvicorn pydantic pynacl pandas cryptography pyyaml

CMD uvicorn mritra.services.enclave_service:app \
    --host 0.0.0.0 --port 8443 \
    --ssl-keyfile /app/secrets/enclave.key \
    --ssl-certfile /app/secrets/enclave.crt \
    --ssl-ca-certs /app/secrets/ca.crt \
    --ssl-cert-reqs 2
