[Unit]
Description=Mritra AI - Confidential Multi-Bank Enclave (mTLS :8443)
Documentation=https://github.com/Alby662/Mritra_AI
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linux1
Group=linux1
WorkingDirectory=/home/linux1/Mritra_AI
Environment="PYTHONPATH=/home/linux1/Mritra_AI"
Environment="PATH=/home/linux1/Mritra_AI/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
ExecStart=/home/linux1/Mritra_AI/.venv/bin/uvicorn mritra.services.enclave_service:app \
    --host 0.0.0.0 --port 8443 \
    --ssl-keyfile /home/linux1/Mritra_AI/secrets/enclave.key \
    --ssl-certfile /home/linux1/Mritra_AI/secrets/enclave.crt \
    --ssl-ca-certs /home/linux1/Mritra_AI/secrets/ca.crt \
    --ssl-cert-reqs 2
Restart=always
RestartSec=5s
LimitNOFILE=65536
StandardOutput=append:/var/log/mritra/enclave.log
StandardError=append:/var/log/mritra/enclave.error.log

[Install]
WantedBy=multi-user.target
