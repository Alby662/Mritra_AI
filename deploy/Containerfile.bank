FROM python:3.11-slim

WORKDIR /app
COPY . /app

RUN pip install --no-cache-dir fastapi uvicorn pydantic pynacl pandas cryptography pyyaml

CMD sh -c "uvicorn mritra.services.bank_service:app \
    --host 0.0.0.0 --port 8000 \
    --ssl-keyfile /app/secrets/${BANK_ID}.key \
    --ssl-certfile /app/secrets/${BANK_ID}.crt \
    --ssl-ca-certs /app/secrets/ca.crt \
    --ssl-cert-reqs 2"
